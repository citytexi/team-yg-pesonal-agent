# 디스코드 개발자 포털에서 발급한 봇 토큰
DISCORD_TOKEN=
# 응답할 길드(서버) ID
GUILD_ID=
# 응답할 채널 ID. 쉼표로 구분
ALLOWED_CHANNEL_IDS=
# claude 를 실행할 저장소 루트 절대경로
REPO_ROOT=
# claude 실행 파일 절대경로. `which claude` 로 확인
CLAUDE_BIN=/opt/homebrew/bin/claude
# 세션 대응표를 저장할 파일 경로
SESSION_FILE=./data/sessions.json
# 동시에 띄울 claude 프로세스 수
MAX_CONCURRENT=2
# 사용자 한 명의 분당 질문 수
RATE_PER_USER_PER_MIN=2
# 하루 총 질문 수
DAILY_QUOTA=60
# claude 프로세스 시간 초과(밀리초)
TIMEOUT_MS=300000
# ── Figma 코멘트 리포트 (선택) ──
# 없으면 figma 명령이 설정 안 됐다고 답한다.
# Figma Personal Access Token
FIGMA_TOKEN=
# 조회할 파일. `파일키:라벨` 쌍을 쉼표로 구분
FIGMA_FILES=
# python 실행 파일. `which python3` 로 확인
PYTHON_BIN=python3
# 리포트 txt 를 남길 디렉토리
FIGMA_REPORT_DIR=./data/reports
# Figma 조회 시간 초과(밀리초)
FIGMA_TIMEOUT_MS=120000
# ── 사주 (선택) ──
# 없으면 !사주 가 설정 안 됐다고 답하고 claude 를 띄우지 않는다.
# saju-manseryeok 스킬 디렉토리 절대경로. 저장소 밖에 둔다
SAJU_SKILL_DIR=
# 사주 스레드 → 세션 대응표 파일. SESSION_FILE 과 달라야 한다
SAJU_SESSION_FILE=./data/saju-sessions.json
# 사주용 claude 의 작업 디렉토리. 저장소 밖이어야 하고, 안이면 시작 오류. 비우면 시스템 임시 디렉토리
SAJU_SANDBOX_DIR=
# 사주 claude 프로세스 시간 초과(밀리초). 비우면 TIMEOUT_MS
SAJU_TIMEOUT_MS=
# saju.py 한 번을 기다리는 시간(밀리초)
SAJU_ENGINE_TIMEOUT_MS=30000
